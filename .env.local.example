# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clé service_role (SERVEUR UNIQUEMENT — ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret JWT de Supabase (Dashboard > Settings > API > JWT Secret).
# Sert à signer une session valide après vérification de la signature Phantom.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ---- Solana ----
# mainnet-beta | devnet | testnet
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Adresse du token SPL VOID (laisser vide tant que non déployé)
NEXT_PUBLIC_TOKEN_MINT=

# ---- Trésor (claim on-chain) — SERVEUR UNIQUEMENT ----
# Clé du trésor qui détient la réserve et signe les transferts au claim.
# En LOCAL : rien à mettre, la route lit ~/voidx-treasury.json par défaut
#   (ou définis TREASURY_KEYPAIR_PATH vers un autre fichier keypair).
# En PROD (Vercel) : colle ici le contenu de voidx-treasury.json
#   (le tableau [12,34,...] à 64 octets), ou une clé secrète base58.
TREASURY_SECRET_KEY=
# TREASURY_KEYPAIR_PATH=
