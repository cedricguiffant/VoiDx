# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clé service_role (SERVEUR UNIQUEMENT — ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret JWT de Supabase (Dashboard > Settings > API > JWT Secret).
# Sert à signer une session valide après vérification de la signature Phantom.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ---- Solana ----
# mainnet-beta | devnet | testnet
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Adresse du futur token SPL (laisser vide tant que non déployé)
NEXT_PUBLIC_TOKEN_MINT=
